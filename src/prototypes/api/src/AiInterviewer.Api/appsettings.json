{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Sqlite",
    "Sqlite": {
      "Path": "data/ai-interviewer.sqlite"
    }
  },
  "TestMode": {
    "Enabled": false
  },
  "MockUploader": {
    "MinStepDelayMs": 3000,
    "MaxStepDelayMs": 8000
  },
  "Media": {
    "Root": "data/media"
  },
  "Transcription": {
    "Provider": "Grpc",
    "Address": "http://localhost:50051"
  }
}
