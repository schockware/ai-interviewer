# Prototype UI configuration. Copy to .env.local (gitignored) to override. NON-SECRET VALUES ONLY.
#
# Vite bundles every VITE_ variable into the page, so anything here is public.
# Never put an API key, token or password in any .env file in this folder
# (docs/decisions/0004-integration-modes-and-secrets.md). A guard test fails if you do.
#
# `npm run dev` loads nothing and runs on mocks. `npm run dev:real` loads .env.dev, which holds
# the connection to the API prototype. Vite also reads .env.local and .env.dev.local (gitignored).

# mock (default) or real. "real" sends the setup pages to the API prototype.
VITE_INTEGRATION=mock

# Where the API prototype listens. The dev server's /api proxy (vite.config.ts) forwards there.
# VITE_API_PROXY_TARGET=http://localhost:5036

# Where the browser reaches the API. The default, /api, goes through the proxy and needs no CORS.
# Set it to the API's own address to call it directly (the API must allow this page's origin).
# VITE_API_URL=/api
