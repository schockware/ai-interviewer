# The dev environment: this UI talking to the API prototype on the same machine.
# Loaded by `npm run dev:real` (vite --mode dev). NON-SECRET VALUES ONLY: see .env.example.
VITE_INTEGRATION=real

# Where the API prototype listens (src/prototypes/api, launchSettings.json, profile "http").
# The dev server's /api proxy (vite.config.ts) forwards to it.
VITE_API_PROXY_TARGET=http://localhost:5036

# What the browser calls. /api goes through the proxy above and needs no CORS.
# To call the API directly instead, set this to the same address as the proxy target;
# the API allows the origin http://localhost:5173 (its appsettings.Development.json).
VITE_API_URL=/api
